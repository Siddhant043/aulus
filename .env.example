# Database
DATABASE_URL=postgres://aulus:aulus@localhost:5432/aulus

# Redis
REDIS_URL=redis://localhost:6379

# YouTube
# Data API v3 key — used for metadata and channel/playlist enumeration.
YOUTUBE_API_KEY=

# LLM
# Primary + optional fallback. No NODE_ENV auto-switch — pick a preset.
# Dev:  LLM_PROVIDER=ollama  LLM_MODEL=llama3.1
# Prod: LLM_PROVIDER=openai  LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
FAST_LLM_PROVIDER=ollama
FAST_LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
# Rerank (default none = RRF order). Keys required only when the matching provider is set.
RERANKER=none
COHERE_API_KEY=
VOYAGE_API_KEY=

# Embeddings
# Fixed OpenAI text-embedding-3-small (1536-dim). Required at startup.
OPENAI_API_KEY=

# LangSmith (optional — tracing is a no-op unless both are set)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aulus
LANGSMITH_ENDPOINT=

# App
NODE_ENV=development
APP_PORT=3000
